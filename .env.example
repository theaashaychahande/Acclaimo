# Copy this file to .env and fill in your own Supabase project.
#
# Both values below are safe to expose in a browser bundle: the project URL is
# a public endpoint and the publishable key is meant to be shipped to clients.
# The safety of your data comes from Row Level Security and the granted RPCs,
# not from hiding these two values.
#
# Never add the secret key or the database password here, and never give them
# a VITE_ prefix. Anything starting with VITE_ is inlined into the public
# JavaScript bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
